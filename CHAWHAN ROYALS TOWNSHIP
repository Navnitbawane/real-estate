      align-items: center;
      gap: 14px;
    }

    .mobile-toggle {
      display: none;
      background: none;
      border: none;
      color: #ffffff;
      cursor: pointer;
      padding: 8px;
    }

    /* Mobile Drawer */
    .mobile-menu-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(5px);
      z-index: 998;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 82%;
      max-width: 380px;
      height: 100vh;
      background: #091224;
      z-index: 999;
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
      border-left: 1px solid rgba(203, 162, 88, 0.25);
      overflow-y: auto;
    }

    .mobile-drawer.active {
