      font-weight: 800;
      color: var(--primary-navy);
      margin-bottom: 18px;
      line-height: 1.25;
    }

    .about-content-block p {
      color: var(--text-body);
      font-size: 1.02rem;
      margin-bottom: 20px;
      line-height: 1.7;
    }

    .about-pillars {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin: 28px 0;
    }

    .pillar-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .pillar-icon {
      width: 36px;
      height: 36px;
      background: var(--accent-gold-light);
      border: 1px solid var(--accent-gold-border);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-gold-hover);
      flex-shrink: 0;
