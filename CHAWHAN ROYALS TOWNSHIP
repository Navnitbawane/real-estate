      padding: 4px 18px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      white-space: nowrap;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .hero-lead-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary-navy);
      text-align: center;
      margin-bottom: 6px;
    }

    .hero-lead-subtitle {
      font-size: 0.88rem;
      color: var(--text-body);
      text-align: center;
      margin-bottom: 22px;
    }

    .lead-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-dark);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-input, .form-select {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      color: var(--text-dark);
      background: #f8fafc;
      transition: var(--transition);
      outline: none;
    }

    .form-input:focus, .form-select:focus {
      border-color: var(--accent-gold);
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(203, 162, 88, 0.15);
    }

    /* ==========================================================================
       6. LIVE URGENCY & ADVANTAGE BAR
       ========================================================================== */
    .urgency-ribbon {
      background: linear-gradient(90deg, #101c3f 0%, #1a2a5e 50%, #101c3f 100%);
      color: #f8fafc;
      padding: 16px 0;
      border-top: 1px solid rgba(203, 162, 88, 0.3);
      border-bottom: 1px solid rgba(203, 162, 88, 0.3);
    }

    .urgency-ribbon-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .urgency-message {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.98rem;
      font-weight: 600;
    }

    .pulse-dot {
      width: 12px;
      height: 12px;
      background-color: #ef4444;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      animation: alertPulse 1.6s infinite;
      flex-shrink: 0;
    }

    @keyframes alertPulse {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      }
      70% {
        transform: scale(1);
        box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
      }
      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
      }
    }

    /* ==========================================================================
       7. SECTION: ABOUT US / THE TOWNSHIP LEGACY
       ========================================================================== */
    .about-section {
      background: #ffffff;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about-visual {
