  <style>
    /* ==========================================================================
       1. STRICT CSS RESET & MOBILE COMPATIBILITY SHIELD
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #0b1120;
      color: #334155;
      line-height: 1.6;
      scroll-behavior: smooth;
    }

    /* Strict container & image controls to eradicate mobile zoom & overflow */
    img, svg, picture, video {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, input, select, textarea {
      font: inherit;
    }

    /* ==========================================================================
       2. DESIGN SYSTEM & COLOR VARIABLES
       ========================================================================== */
    :root {
      --primary-navy: #091224;
      --secondary-navy: #0f1c3f;
      --navy-card: #14224b;
      --accent-gold: #cba258;
      --accent-gold-hover: #b88f42;
      --accent-gold-light: #f9f5ec;
      --accent-gold-border: rgba(203, 162, 88, 0.35);
      --call-emerald: #059669;
      --call-emerald-hover: #047857;
      --whatsapp-green: #25D366;
      --whatsapp-dark: #128C7E;
      --text-dark: #0f172a;
      --text-body: #475569;
      --text-light: #94a3b8;
      --bg-light: #f8fafc;
      --bg-white: #ffffff;
      --border-light: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(9, 18, 36, 0.08);
      --shadow-lg: 0 20px 40px -15px rgba(9, 18, 36, 0.15);
      --shadow-glow: 0 0 30px rgba(203, 162, 88, 0.25);
      --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Font classes */
    .font-serif {
      font-family: 'Playfair Display', Georgia, serif;
    }
    .font-heading {
      font-family: 'Outfit', sans-serif;
    }

    /* Structural containers */
    .container {
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    .section-padding {
      padding-top: 85px;
      padding-bottom: 85px;
    }

    /* Headings & Subheadings */
    .section-header {
      text-align: center;
      max-width: 780px;
      margin: 0 auto 50px auto;
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(203, 162, 88, 0.12);
      border: 1px solid var(--accent-gold-border);
      color: #936814;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .badge-pill.dark-badge {
      background: rgba(203, 162, 88, 0.15);
      color: #e6be75;
      border: 1px solid rgba(203, 162, 88, 0.4);
    }

    .section-title {
      font-size: 2.35rem;
      font-weight: 700;
      color: var(--text-dark);
      line-height: 1.25;
      margin-bottom: 16px;
    }

    .section-title.light-title {
      color: #ffffff;
    }

    .section-subtitle {
      font-size: 1.05rem;
      color: var(--text-body);
      line-height: 1.6;
    }

    .section-subtitle.light-subtitle {
      color: #cbd5e1;
    }

    /* High-Converting Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      padding: 14px 28px;
      border-radius: var(--radius-md);
      cursor: pointer;
      border: none;
      transition: var(--transition);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .btn-call {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
