    .btn-call:hover {
      background: linear-gradient(135deg, #047857 0%, #065f46 100%);
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(5, 150, 105, 0.45);
      color: #ffffff;
    }

    .btn-whatsapp {
      background: linear-gradient(135deg, #25D366 0%, #1da851 100%);
      color: #ffffff;
      box-shadow: 0 10px 25px rgba(37, 211, 102, 0.3);
    }

    .btn-whatsapp:hover {
      background: linear-gradient(135deg, #20ba5a 0%, #198f45 100%);
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(37, 211, 102, 0.45);
      color: #ffffff;
    }

    .btn-gold {
      background: linear-gradient(135deg, #d8b26a 0%, #b88f42 100%);
      color: #091224;
      font-weight: 800;
      box-shadow: 0 10px 25px rgba(203, 162, 88, 0.3);
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, #e3c07b 0%, #cba258 100%);
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(203, 162, 88, 0.45);
    }

    .btn-outline-gold {
      background: transparent;
      color: #f1dfb8;
      border: 2px solid #cba258;
    }

    .btn-outline-gold:hover {
      background: rgba(203, 162, 88, 0.15);
      color: #ffffff;
      border-color: #e3c07b;
      transform: translateY(-2px);
    }

    @keyframes subtlePulse {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.5);
      }
      50% {
        box-shadow: 0 0 0 14px rgba(5, 150, 105, 0);
      }
    }

    /* ==========================================================================
       3. TOP ANNOUNCEMENT & VERIFICATION BAR
       ========================================================================== */
    .top-announcement {
      background: #040915;
      color: #cbd5e1;
      padding: 8px 0;
      font-size: 0.84rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
