      font-size: 1.55rem;
      font-weight: 800;
      color: var(--accent-gold);
      line-height: 1.1;
    }

    .hero-stat-card .label {
      font-size: 0.78rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 4px;
      font-weight: 600;
    }

    /* Hero Lead Capture Card */
    .hero-lead-card {
      background: #ffffff;
      border-radius: var(--radius-xl);
      padding: 34px 30px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      color: var(--text-dark);
      position: relative;
      border: 2px solid #f1dfb8;
    }

    .hero-lead-badge {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #cba258 0%, #9e7529 100%);
