      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      object-fit: cover;
      height: 480px;
    }

    .about-floating-card {
      position: absolute;
      bottom: -25px;
      right: -20px;
      background: #091224;
      color: #ffffff;
      padding: 22px 26px;
      border-radius: var(--radius-lg);
      border: 2px solid var(--accent-gold);
      box-shadow: var(--shadow-lg);
      max-width: 260px;
    }

    .about-floating-card .big-text {
      font-family: 'Outfit', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--accent-gold);
      line-height: 1;
    }

    .about-floating-card .sub-text {
